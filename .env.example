# Copy to .env.local for local development. In Vercel set the same names
# under Project → Settings → Environment Variables, then redeploy.

# Supabase — Project Settings → API (or "API Keys").
# The anon / publishable key is safe in the browser: row-level security in
# supabase/migrations decides what it can do. NEVER put the service_role /
# secret key in a VITE_ variable — those end up in the public bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Fanaar Accounts — the partners' private books, in their OWN Supabase
# project (accounts/supabase/migrations), opened from Settings in the admin.
# Same kind of keys as above (URL + anon / publishable key), from that
# project. In that project: Authentication → turn sign-ups off, add each
# partner as a user, and add them to public.members.
VITE_ACCOUNTS_SUPABASE_URL=
VITE_ACCOUNTS_SUPABASE_ANON_KEY=

# Meta (Facebook) Pixel ID. Falls back to 1278679466701518 (the pixel the
# old Shopify store reported to) when unset.
VITE_META_PIXEL_ID=1278679466701518

# Server-only (Vercel → type "Secret"; never a VITE_ variable): the
# Conversions API token for api/order-confirmed.js. See docs/SETUP.md.
# META_CAPI_TOKEN=
# META_TEST_EVENT_CODE=
# PostEx merchant API token for api/postex.js (booking from the admin).
# POSTEX_API_TOKEN=
